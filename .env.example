# Local testing only. On GitHub, put these in Settings > Secrets and variables > Actions.
SERPAPI_KEY=
# Email (Gmail: enable 2-Step Verification, then create an App Password)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com
# Optional: other SMTP host (default smtp.gmail.com:465)
SMTP_HOST=
SMTP_PORT=
# Optional Telegram (free)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional WhatsApp Cloud API (NOT free for proactive alerts, see README)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en
